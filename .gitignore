!/data/monitoring/*

# Model weights and artifacts (candidate models ignored; 3 production tier models tracked for zero-cost deployment)
/models_candidate/
/models/*
!/models/.gitkeep
!/models/model_tier_*.joblib
*.pkl
*.pickle
*.onnx

